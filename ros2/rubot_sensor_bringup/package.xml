<?xml version="1.0"?>
<package format="3">
  <name>rubot_sensor_bringup</name>
  <version>0.1.0</version>
  <description>Multi-robot bringup for rUBot platforms and environmental sensors.</description>
  <maintainer email="manel.puig@ub.edu">Manel Puig</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ens160_air_quality_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rubot_ens160_mapping</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Robot-specific dependencies are selected by ROS distribution. -->
  <exec_depend condition="$ROS_DISTRO == 'humble'">my_robot_bringup</exec_depend>
  <exec_depend condition="$ROS_DISTRO == 'jazzy'">rosbot_bringup</exec_depend>
  <exec_depend condition="$ROS_DISTRO == 'jazzy'">rosbot_gazebo</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
